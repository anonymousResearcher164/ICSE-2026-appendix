<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Repeat num_cycles="3">
      <Sequence name="echo_sequence">
        <SpeechToTextActionClient name="stt_1" text="{said}"/>
        <TextToSpeechActionClient name="tts_1" message="{said}"/>
        <SpeechToTextActionClient name="stt_2" text="{said}"/>
        <TextToSpeechActionClient name="tts_2" message="{said}"/>
      </Sequence>
    </Repeat>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="SpeechToTextActionClient">
      <output_port name="text">Transcribed speech</output_port>
    </Action>
    <Action ID="TextToSpeechActionClient">
      <input_port name="message">Text to speak</input_port>
    </Action>
  </TreeNodesModel>
</root>