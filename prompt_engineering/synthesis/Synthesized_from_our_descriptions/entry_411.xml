<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">
    <Sequence>
      <SubTree ID="FullCompetitionMode"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="FullCompetitionMode">
    <Repeat num_cycles="-1">
      <Sequence>
        <SubTree ID="GetInRestPose"/>
        <SubTree ID="DoYourTrick"/>
      </Sequence>
    </Repeat>
  </BehaviorTree>

  <BehaviorTree ID="GetInRestPose">
    <Sequence>
      <GetArmJointsForPose pose="REST" joints_pose="{joints_pose}"/>
      <Parallel success_count="3" failure_count="3">
        <Sequence>
          <HeadControl pitch="0" yaw="90"/>
          <TorsoControl rel_height="0.05"/>
        </Sequence>
        <SetArmJointsLeft joints_pose="{joints_pose}"/>
        <SetArmJointsRight joints_pose="{joints_pose}"/>
      </Parallel>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="DoYourTrick">
    <Repeat num_cycles="-1">
      <Sequence>
        <ForceSuccess>
          <SubTree ID="FillYourTray"/>
        </ForceSuccess>
        <ForceSuccess>
          <SubTree ID="FillTheShelf"/>
        </ForceSuccess>
      </Sequence>
    </Repeat>
  </BehaviorTree>

  <BehaviorTree ID="FillYourTray">
    <Sequence>
      <SubTree ID="GoToTable"/>
      <SubTree ID="ScanTable"/>
      <TorsoControl rel_height="0.95"/>
      <HeadControl pitch="0.0" yaw="135.0"/>
      <Repeat num_cycles="-1">
        <Sequence>
          <Sequence>
            <SetBlackboard output_key="tray" value="table"/>
            <SetBlackboard output_key="side" value="RIGHT"/>
            <SubTree ID="TrayIsEmpty" tray="{tray}" side="{side}"/>
          </Sequence>
          <Inverter>
            <Sequence>
              <SetBlackboard output_key="tray" value="backtray"/>
              <SubTree ID="TrayIsFull" tray="{tray}"/>
            </Sequence>
          </Inverter>
          <ForceSuccess>
            <Sequence>
              <SetBlackboard output_key="src_tray" value="table"/>
              <SetBlackboard output_key="dst_tray" value="backtray"/>
              <SubTree ID="RightArmFillYourTray"
                       src_tray="{src_tray}" dst_tray="{dst_tray}"/>
            </Sequence>
          </ForceSuccess>
        </Sequence>
      </Repeat>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="GoToTable">
    <Sequence>
      <MoveBase goal="1.5;-0.1;0.0"/>
      <MoveBase goal="2.2;-0.1;0.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="ScanTable">
    <RetryUntilSuccessful num_attempts="-1">
      <Sequence>
        <TorsoControl rel_height="0.95"/>
        <HeadControl pitch="0.0" yaw="140.0"/>
        <Pause time_limit="3"/>
        <ScanTableStart/>
        <Pause time_limit="3"/>
        <SubTree ID="ClearAllOctomaps"/>
        <ScanTableGetResults detected_tomato_cans="{detected_tomato_cans}"/>
        <TraySetLoci tray_name="table" locus_poses="{detected_tomato_cans}" occupied="true"/>
        <UpdatePlanningScene/>
      </Sequence>
    </RetryUntilSuccessful>
  </BehaviorTree>

  <BehaviorTree ID="ClearAllOctomaps">
    <ForceSuccess>
      <Sequence>
        <ClearOctomap side="left"/>
        <ClearOctomap side="right"/>
      </Sequence>
    </ForceSuccess>
  </BehaviorTree>

  <BehaviorTree ID="FillTheShelf">
    <Sequence>
      <SubTree ID="GetInRestPose"/>
      <SubTree ID="GoToShelves"/>
      <SubTree ID="ScanShelves"/>
      <SubTree ID="UpdateOctomap"/>
      <TorsoControl rel_height="0.1"/>
      <HeadControl pitch="60.0" yaw="110.0"/>
      <Repeat num_cycles="-1">
        <Sequence>
          <Sequence>
            <SetBlackboard output_key="tray" value="backtray"/>
            <SetBlackboard output_key="side" value="LEFT"/>
            <SubTree ID="TrayIsEmpty" tray="{tray}" side="{side}"/>
          </Sequence>
          <Inverter>
            <Sequence>
              <SetBlackboard output_key="tray" value="shelf"/>
              <SubTree ID="TrayIsFull" tray="{tray}"/>
            </Sequence>
          </Inverter>
          <ForceSuccess>
            <Sequence>
              <SetBlackboard output_key="src_tray" value="backtray"/>
              <SetBlackboard output_key="dst_tray" value="shelf"/>
              <SubTree ID="LeftArmFillYourTray"
                       src_tray="{src_tray}" dst_tray="{dst_tray}"/>
            </Sequence>
          </ForceSuccess>
        </Sequence>
      </Repeat>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="GoToShelves">
    <Sequence>
      <MoveBase goal="1.0;-0.3.0;0.0"/>
      <MoveBase goal="2.0;-0.3;0.4"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="ScanShelves">
    <Sequence>
      <TorsoControl rel_height="0.1"/>
      <HeadControl pitch="90.0" yaw="90.0"/>
      <Pause time_limit="1"/>
      <ScanShelves tomato_can_stocking_target_poses="{tomato_can_stocking_target_poses}"/>
      <TraySetLoci tray_name="shelf"
                   locus_poses="{tomato_can_stocking_target_poses}" occupied="false"/>
      <UpdatePlanningScene/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="UpdateOctomap">
    <ForceSuccess>
      <Sequence>
        <SubTree ID="ClearAllOctomaps"/>
        <HeadControl pitch="60.0" yaw="90"/>
        <HeadControl pitch="60.0" yaw="135"/>
      </Sequence>
    </ForceSuccess>
  </BehaviorTree>

  <BehaviorTree ID="LeftArmFillYourTray">
    <Sequence>
      <TrayPickOccupiedLocus tray_name="{src_tray}" side="LEFT" locus_id="{src_locus_id}"/>
      <Fallback>
        <Sequence>
          <TrayPickEmptyLocus tray_name="{dst_tray}" side="LEFT"
                              locus_id="{dst_locus_id}" locus_pose="{dst_locus_pose}"/>
          <Fallback>
            <Sequence>
              <ForceSuccess>
                <UpdatePlanningScene/>
              </ForceSuccess>
              <PickAndPlaceLeft object_id="{src_locus_id}" target_pose="{dst_locus_pose}"
                                flat_hand_mode="true"/>
              <TraySetLocusState tray_name="{src_tray}" locus_id="{src_locus_id}" occupied="false"/>
              <TraySetLocusState tray_name="{dst_tray}" locus_id="{dst_locus_id}" occupied="true"/>
              <TrayReleaseLocus tray_name="{dst_tray}" locus_id="{dst_locus_id}"/>
            </Sequence>
            <ForceFailure>
              <TrayReleaseLocus tray_name="{dst_tray}" locus_id="{dst_locus_id}"/>
            </ForceFailure>
          </Fallback>
        </Sequence>
        <ForceFailure>
          <TrayReleaseLocus tray_name="{src_tray}" locus_id="{src_locus_id}"/>
        </ForceFailure>
      </Fallback>
      <TrayReleaseLocus tray_name="{src_tray}" locus_id="{src_locus_id}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="RightArmFillYourTray">
    <Sequence>
      <TrayPickOccupiedLocus tray_name="{src_tray}" side="RIGHT" locus_id="{src_locus_id}"/>
      <Fallback>
        <Sequence>
          <TrayPickEmptyLocus tray_name="{dst_tray}" side="RIGHT"
                              locus_id="{dst_locus_id}" locus_pose="{dst_locus_pose}"/>
          <Fallback>
            <Sequence>
              <ForceSuccess>
                <UpdatePlanningScene/>
              </ForceSuccess>
              <PickAndPlaceRight object_id="{src_locus_id}" target_pose="{dst_locus_pose}"
                                 flat_hand_mode="false"/>
              <TraySetLocusState tray_name="{src_tray}" locus_id="{src_locus_id}" occupied="false"/>
              <TraySetLocusState tray_name="{dst_tray}" locus_id="{dst_locus_id}" occupied="true"/>
              <TrayReleaseLocus tray_name="{dst_tray}" locus_id="{dst_locus_id}"/>
            </Sequence>
            <ForceFailure>
              <TrayReleaseLocus tray_name="{dst_tray}" locus_id="{dst_locus_id}"/>
            </ForceFailure>
          </Fallback>
        </Sequence>
        <ForceFailure>
          <TrayReleaseLocus tray_name="{src_tray}" locus_id="{src_locus_id}"/>
        </ForceFailure>
      </Fallback>
      <TrayReleaseLocus tray_name="{src_tray}" locus_id="{src_locus_id}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TrayIsFull">
    <Inverter>
      <Sequence>
        <Fallback>
          <TrayPickEmptyLocus tray_name="{tray}" side="LEFT"
                              locus_id="{locus_id}" locus_pose="{locus_pose}"/>
          <TrayPickEmptyLocus tray_name="{tray}" side="RIGHT"
                              locus_id="{locus_id}" locus_pose="{locus_pose}"/>
        </Fallback>
        <ForceSuccess>
          <TrayReleaseLocus tray_name="{tray}" locus_id="{locus_id}"/>
        </ForceSuccess>
      </Sequence>
    </Inverter>
  </BehaviorTree>

  <BehaviorTree ID="TrayIsEmpty">
    <Fallback>
      <Sequence>
        <TrayPickOccupiedLocus tray_name="{tray}" side="{side}" locus_id="{locus_id}"/>
        <ForceSuccess>
          <TrayReleaseLocus tray_name="{tray}" locus_id="{locus_id}"/>
        </ForceSuccess>
        <AlwaysSuccess/>
      </Sequence>
      <AlwaysFailure/>
    </Fallback>
  </BehaviorTree>

  <TreeNodesModel>
    <SubTree ID="TrayIsEmpty">
      <input_port name="tray"/>
      <input_port name="side"/>
    </SubTree>
    <SubTree ID="TrayIsFull">
      <input_port name="tray"/>
    </SubTree>
    <SubTree ID="LeftArmFillYourTray">
      <input_port name="src_tray"/>
      <input_port name="dst_tray"/>
    </SubTree>
    <SubTree ID="RightArmFillYourTray">
      <input_port name="src_tray"/>
      <input_port name="dst_tray"/>
    </SubTree>
    <Action ID="GetArmJointsForPose">
      <input_port name="pose"/>
      <output_port name="joints_pose"/>
    </Action>
    <Action ID="SetArmJointsLeft">
      <input_port name="joints_pose"/>
    </Action>
    <Action ID="SetArmJointsRight">
      <input_port name="joints_pose"/>
    </Action>
    <Action ID="HeadControl">
      <input_port name="pitch"/>
      <input_port name="yaw"/>
    </Action>
    <Action ID="TorsoControl">
      <input_port name="rel_height"/>
    </Action>
    <Action ID="MoveBase">
      <input_port name="goal"/>
    </Action>
    <Action ID="Pause">
      <input_port name="time_limit"/>
    </Action>
    <Action ID="ScanTableStart"/>
    <Action ID="ScanTableGetResults">
      <output_port name="detected_tomato_cans"/>
    </Action>
    <Action ID="ScanShelves">
      <output_port name="tomato_can_stocking_target_poses"/>
    </Action>
    <Action ID="TraySetLoci">
      <input_port name="tray_name"/>
      <input_port name="locus_poses"/>
      <input_port name="occupied"/>
    </Action>
    <Action ID="UpdatePlanningScene"/>
    <Action ID="ClearOctomap">
      <input_port name="side"/>
    </Action>
    <Action ID="TrayPickOccupiedLocus">
      <input_port name="tray_name"/>
      <input_port name="side"/>
      <output_port name="locus_id"/>
    </Action>
    <Action ID="TrayPickEmptyLocus">
      <input_port name="tray_name"/>
      <input_port name="side"/>
      <output_port name="locus_id"/>
      <output_port name="locus_pose"/>
    </Action>
    <Action ID="PickAndPlaceLeft">
      <input_port name="object_id"/>
      <input_port name="target_pose"/>
      <input_port name="flat_hand_mode"/>
    </Action>
    <Action ID="PickAndPlaceRight">
      <input_port name="object_id"/>
      <input_port name="target_pose"/>
      <input_port name="flat_hand_mode"/>
    </Action>
    <Action ID="TraySetLocusState">
      <input_port name="tray_name"/>
      <input_port name="locus_id"/>
      <input_port name="occupied"/>
    </Action>
    <Action ID="TrayReleaseLocus">
      <input_port name="tray_name"/>
      <input_port name="locus_id"/>
    </Action>
  </TreeNodesModel>
</root>