<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Fallback>
      <ReactiveSequence>
        <PullOver_Request/>
        <PullOver_Ready/>
        <PullOver_Plan output="{output}"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <PullOut_Request/>
        <PullOut_Ready/>
        <PullOut_Plan output="{output}"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <SideShift_Request/>
        <SideShift_Ready/>
        <SideShift_Plan output="{output}"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <LaneChange_Request/>
        <Fallback>
          <LaneChange_Ready/>
          <ForceLaneChange_ForceApproval/>
        </Fallback>
        <LaneChange_Plan output="{output}"/>
      </ReactiveSequence>
      <ReactiveSequence>
        <Avoidance_Request/>
        <Avoidance_Ready/>
        <Avoidance_Plan output="{output}"/>
      </ReactiveSequence>
      <LaneFollowing_Plan output="{output}"/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="a">
    <ReactiveFallback>
      <LaneChange_CheckApproval/>
      <KeepRunningUntilFailure>
        <LaneChange_PlanCandidate output="{output}"/>
      </KeepRunningUntilFailure>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="b">
    <ReactiveFallback>
      <Avoidance_CheckApproval/>
      <KeepRunningUntilFailure>
        <Avoidance_PlanCandidate output="{output}"/>
      </KeepRunningUntilFailure>
    </ReactiveFallback>
  </BehaviorTree>

  <TreeNodesModel>
    <Condition ID="PullOver_Request"/>
    <Condition ID="PullOver_Ready"/>
    <Condition ID="PullOut_Request"/>
    <Condition ID="PullOut_Ready"/>
    <Condition ID="SideShift_Request"/>
    <Condition ID="SideShift_Ready"/>
    <Condition ID="LaneChange_Request"/>
    <Condition ID="LaneChange_Ready"/>
    <Condition ID="ForceLaneChange_ForceApproval"/>
    <Condition ID="Avoidance_Request"/>
    <Condition ID="Avoidance_Ready"/>
    <Condition ID="LaneChange_CheckApproval"/>
    <Condition ID="Avoidance_CheckApproval"/>
    <Action ID="PullOver_Plan">
      <output_port name="output"/>
    </Action>
    <Action ID="PullOut_Plan">
      <output_port name="output"/>
    </Action>
    <Action ID="SideShift_Plan">
      <output_port name="output"/>
    </Action>
    <Action ID="LaneChange_Plan">
      <output_port name="output"/>
    </Action>
    <Action ID="Avoidance_Plan">
      <output_port name="output"/>
    </Action>
    <Action ID="LaneFollowing_Plan">
      <output_port name="output"/>
    </Action>
    <Action ID="LaneChange_PlanCandidate">
      <output_port name="output"/>
    </Action>
    <Action ID="Avoidance_PlanCandidate">
      <output_port name="output"/>
    </Action>
  </TreeNodesModel>
</root>