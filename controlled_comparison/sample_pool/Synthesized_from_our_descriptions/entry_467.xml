<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Fallback name="root_fallback">

      <Sequence name="move_sequence">
        <MoveObject action="{action}"
                    move_base_finished="{move_base_finished}"
                    move_base_idle="{move_base_idle}"
                    pose_queue_size="{pose_queue_size}"/>
        <WaitObject action="{action}" wait_duration="3"/>
      </Sequence>

      <Sequence name="return_sequence">
        <ReturnObject action="{action}"
                      home_pose_far="{home_pose_far}"
                      move_base_finished="{move_base_finished}"
                      move_base_idle="{move_base_idle}"/>
        <WaitObject action="{action}" wait_duration="3"/>
      </Sequence>

      <StandbyObject action="{action}"/>

    </Fallback>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="MoveObject">
      <output_port name="action"/>
      <input_port name="move_base_finished"/>
      <input_port name="move_base_idle"/>
      <input_port name="pose_queue_size"/>
    </Action>
    <Action ID="ReturnObject">
      <output_port name="action"/>
      <input_port name="home_pose_far"/>
      <input_port name="move_base_finished"/>
      <input_port name="move_base_idle"/>
    </Action>
    <Action ID="WaitObject">
      <output_port name="action"/>
      <input_port name="wait_duration"/>
    </Action>
    <Action ID="StandbyObject">
      <output_port name="action"/>
    </Action>
  </TreeNodesModel>
</root>