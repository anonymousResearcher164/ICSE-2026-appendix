<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Parallel success_count="2" failure_count="1">

      <Repeat num_cycles="-1">
        <VariantAction variant="{variant}"/>
      </Repeat>

      <Sequence name="person_recognition">
        <peoplerecognition/>
        <Fallback name="locate_person">
          <getPersonPose/>
          <moveRoboterPosition approachRadius="200" x="3000" y="-12000"/>
        </Fallback>
      </Sequence>

    </Parallel>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="VariantAction">
      <input_port name="variant"/>
    </Action>
    <Action ID="peoplerecognition"/>
    <Action ID="getPersonPose"/>
    <Action ID="moveRoboterPosition">
      <input_port name="approachRadius"/>
      <input_port name="x"/>
      <input_port name="y"/>
    </Action>
  </TreeNodesModel>
</root>