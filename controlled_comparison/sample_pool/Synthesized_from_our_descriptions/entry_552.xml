<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Repeat num_cycles="-1">
      <Sequence name="outer_sequence">
        <TrayUpdatePlanningScene/>
        <MoveBase goal="2.1;-2.0;0.0"/>
        <MoveBase goal="2.1;-0.0;1.57"/>
        <Sequence name="scan_shelves">
          <TorsoControl relative_height="0.1"/>
          <HeadControl pitch="0.0" yaw="90.0"/>
          <ScanShelves tomato_can_stocking_target_poses="{tomato_can_stocking_target_poses}"/>
          <TraySetLoci tray_name="shelf"
                       locus_poses="{tomato_can_stocking_target_poses}"
                       occupied="false"/>
          <TrayUpdatePlanningScene/>
        </Sequence>
        <Pause time_limit="5"/>
      </Sequence>
    </Repeat>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="TrayUpdatePlanningScene"/>
    <Action ID="MoveBase">
      <input_port name="goal"/>
    </Action>
    <Action ID="TorsoControl">
      <input_port name="relative_height"/>
    </Action>
    <Action ID="HeadControl">
      <input_port name="pitch"/>
      <input_port name="yaw"/>
    </Action>
    <Action ID="ScanShelves">
      <output_port name="tomato_can_stocking_target_poses"/>
    </Action>
    <Action ID="TraySetLoci">
      <input_port name="tray_name"/>
      <input_port name="locus_poses"/>
      <input_port name="occupied"/>
    </Action>
    <Action ID="Pause">
      <input_port name="time_limit"/>
    </Action>
  </TreeNodesModel>
</root>