<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">
    <SubTree ID="ChargeST"/>
  </BehaviorTree>

  <BehaviorTree ID="ChargeST">
    <SequenceWithMemory name="charge_sequence">
      <Speak action_name="/gcloud_tts" language="pt_PT"
             utterance="Tenho fome" voice="pt-PT-Wavenet-D"/>
      <WaitForXSeconds result="SUCCESS" seconds="2"/>

      <Fallback name="go_charge">
        <SequenceWithMemory name="move_and_charge">
          <RetryUntilSuccessful num_attempts="3">
            <MoveBase action_name="move_base" frame_id="map"
                      goal_pose="-1.7971;-5.5118;0.0;0;0;0.72703;0.68659"/>
          </RetryUntilSuccessful>
          <Parallel success_count="2" failure_count="1">
            <Charge action="CHARGE" action_name="charging_action"/>
            <Repeat num_cycles="5">
              <Speak action_name="/gcloud_tts" language="pt_PT"
                     utterance="bip bip" voice="pt-PT-Wavenet-D"/>
            </Repeat>
          </Parallel>
        </SequenceWithMemory>
      </Fallback>

      <WaitForXSeconds result="SUCCESS" seconds="10"/>
      <Speak action_name="/gcloud_tts" language="pt_PT"
             utterance="Estou cheio, vou sair da estação" voice="pt-PT-Wavenet-D"/>
      <Charge action="STOP_CHARGE" action_name="charging_action"/>
    </SequenceWithMemory>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="Speak">
      <input_port name="action_name"/>
      <input_port name="language"/>
      <input_port name="utterance"/>
      <input_port name="voice"/>
    </Action>
    <Action ID="WaitForXSeconds">
      <input_port name="result"/>
      <input_port name="seconds"/>
    </Action>
    <Action ID="MoveBase">
      <input_port name="action_name"/>
      <input_port name="frame_id"/>
      <input_port name="goal_pose"/>
    </Action>
    <Action ID="Charge">
      <input_port name="action"/>
      <input_port name="action_name"/>
    </Action>
  </TreeNodesModel>
</root>