<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Repeat num_cycles="{num_cycles}">
      <Sequence name="ltl_cycle">
        <LTLPreCheck ltl_state_current="{ltl_state_current}"
                     ltl_state_desired_sequence="{ltl_state_desired_sequence}"/>
        <MoveAction move_base_finished="{move_base_finished}"
                    move_base_idle="{move_base_idle}"
                    nav_goal="{nav_goal}"
                    action="{action}"/>
        <UpdateLTL action_sequence="{action_sequence}"
                   ltl_state_desired_sequence="{ltl_state_desired_sequence}"
                   nav_goal="{nav_goal}"/>
      </Sequence>
    </Repeat>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="LTLPreCheck">
      <input_port name="ltl_state_current"/>
      <input_port name="ltl_state_desired_sequence"/>
    </Action>
    <Action ID="MoveAction">
      <input_port name="move_base_finished"/>
      <input_port name="move_base_idle"/>
      <input_port name="nav_goal"/>
      <output_port name="action"/>
    </Action>
    <Action ID="UpdateLTL">
      <inout_port name="action_sequence"/>
      <inout_port name="ltl_state_desired_sequence"/>
      <output_port name="nav_goal"/>
    </Action>
  </TreeNodesModel>
</root>