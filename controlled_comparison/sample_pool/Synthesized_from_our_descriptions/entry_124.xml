<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="root_sequence">

      <!-- Collision setup -->
      <Sequence name="collision_setup">
        <ExecuteAddPlane name="Add groud to scene"
                         group_name="arm" plane_name="ground"
                         plane_normal="0 0 1" plane_pose="0 0 0 0 0 0 1"
                         service_name="execute_add_plane"/>
        <ExecuteAddBox name="Add left wall"
                       auto_subfix="1" box_name="left_wall"
                       box_pose="2.76 1.2 1.35 0 0 0 1" box_size="5.0 0.001 2.7"
                       group_name="arm" is_absolute="1" service_name="execute_add_box"/>
        <ExecuteAddBox name="Add right wall"
                       auto_subfix="1" box_name="right_wall"
                       box_pose="2.76 -1.2 1.35 0 0 0 1" box_size="5.0 0.001 2.7"
                       group_name="arm" is_absolute="1" service_name="execute_add_box"/>
        <ExecuteAddBox name="Add top wall"
                       auto_subfix="1" box_name="top_wall"
                       box_pose="4 0 2.7 0 0 0 1" box_size="2 2.4 0.001"
                       group_name="arm" is_absolute="1" service_name="execute_add_box"/>
        <ExecuteAddBox name="Add conveyor"
                       auto_subfix="1" box_name="conveyor"
                       box_pose="-1.341 0 0.25 0 0 0 1" box_size="2.56 0.56 0.5"
                       group_name="arm" is_absolute="1" service_name="execute_add_box"/>
      </Sequence>

      <!-- Box surface, once -->
      <Repeat num_cycles="1">
        <ExecuteAddBox name="box_surface"
                       auto_subfix="0" box_name="boxsur"
                       box_pose="0.901 0 1.35 0 0 0 1" box_size="0.001 2.4 2.7"
                       group_name="arm" is_absolute="1" service_name="execute_add_box"/>
      </Repeat>

      <!-- Left side, once -->
      <Repeat num_cycles="1">
        <Sequence name="left_sequence">
          <ExecuteGroupJointStates name="pre middle left"
                                   goal="0.0829 -1.7568 2.5506 0.7786 -1.5734 -0.0038"
                                   group_name="arm" service_name="execute_group_joint_states"
                                   tolerance="0.01"/>
          <ExecuteRemoveObject name="remove boxes_surface"
                               is_exact="1" obj_name="boxsur"
                               service_name="execute_remove_object"/>
          <ExecuteGroupManyPoses name="pick"
                                 constraint="" eef_step="0.1" goal_type="0"
                                 goals="0.88 0.4994 0.5723 0.4979 0.5006 0.5000 0.5012"
                                 group_name="arm" service_name="execute_group_many_poses"
                                 tolerance="0.01"/>
          <ExecuteGroupShift name="lift up"
                             axis="z" goal="0.1" group_name="arm" is_absolute="0"
                             service_name="execute_group_shift" tolerance="0.01"/>
          <ExecuteGroupShift name="pull out"
                             axis="x" goal="-0.4" group_name="arm" is_absolute="0"
                             service_name="execute_group_shift" tolerance="0.01"/>
          <ExecuteGroupJointStates name="post middle left"
                                   goal="0.7015 0.4237 1.7017 -0.0747 -0.0040 -0.0806"
                                   group_name="arm" service_name="execute_group_joint_states"
                                   tolerance="0.01"/>
          <ExecuteGroupJointStates name="place"
                                   goal="0.7005 1.8997 2.0341 0.8173 0.0009 -0.0041"
                                   group_name="arm" service_name="execute_group_joint_states"
                                   tolerance="0.01"/>
          <ExecuteGroupJointStates name="post middle left"
                                   goal="0.7015 0.4237 1.7017 -0.0747 -0.0040 -0.0806"
                                   group_name="arm" service_name="execute_group_joint_states"
                                   tolerance="0.01"/>
          <ExecuteAddBox name="box_surface"
                         auto_subfix="0" box_name="boxsur"
                         box_pose="0.901 0 1.35 0 0 0 1" box_size="0.001 2.4 2.7"
                         group_name="arm" is_absolute="1" service_name="execute_add_box"/>
        </Sequence>
      </Repeat>

      <!-- Right side, once -->
      <Repeat num_cycles="1">
        <Sequence name="right_sequence">
          <ExecuteGroupJointStates name="pre middle right"
                                   goal="0.0777 1.8904 -2.4741 -0.9875 1.5718 -0.0037"
                                   group_name="arm" service_name="execute_group_joint_states"
                                   tolerance="0.01"/>
          <ExecuteRemoveObject name="ExecuteRemoveObject"
                               is_exact="1" obj_name="boxsur"
                               service_name="execute_remove_object"/>
          <ExecuteGroupManyPoses name="pick"
                                 constraint="" eef_step="0.1" goal_type="0"
                                 goals="0.88 -0.4455 0.5713 -0.5115 0.4876 -0.4901 0.5101"
                                 group_name="arm" service_name="execute_group_many_poses"
                                 tolerance="0.01"/>
          <ExecuteGroupShift name="lift up"
                             axis="z" goal="0.1" group_name="arm" is_absolute="0"
                             service_name="execute_group_shift" tolerance="0.01"/>
          <ExecuteGroupShift name="pull out"
                             axis="x" goal="-0.4" group_name="arm" is_absolute="0"
                             service_name="execute_group_shift" tolerance="0.01"/>
          <ExecuteGroupJointStates name="post middle left"
                                   goal="0.7015 -0.4631 -1.6642 -1.0472 0.0081 -0.0615"
                                   group_name="arm" service_name="execute_group_joint_states"
                                   tolerance="0.01"/>
          <ExecuteGroupJointStates name="place left"
                                   goal="0.7015 -1.8999 -2.0660 -0.7844 0.0080 -0.0615"
                                   group_name="arm" service_name="execute_group_joint_states"
                                   tolerance="0.01"/>
          <ExecuteGroupJointStates name="post middle left"
                                   goal="0.7015 -0.4631 -1.6642 -1.0472 0.0081 -0.0615"
                                   group_name="arm" service_name="execute_group_joint_states"
                                   tolerance="0.01"/>
          <ExecuteAddBox name="boxes_surface"
                         auto_subfix="0" box_name="boxsur"
                         box_pose="0.901 0 1.35 0 0 0 1" box_size="0.001 2.4 2.7"
                         group_name="arm" is_absolute="1" service_name="execute_add_box"/>
        </Sequence>
      </Repeat>

    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="ExecuteAddPlane">
      <input_port name="group_name"/>
      <input_port name="plane_name"/>
      <input_port name="plane_normal"/>
      <input_port name="plane_pose"/>
      <input_port name="service_name"/>
    </Action>
    <Action ID="ExecuteAddBox">
      <input_port name="auto_subfix"/>
      <input_port name="box_name"/>
      <input_port name="box_pose"/>
      <input_port name="box_size"/>
      <input_port name="group_name"/>
      <input_port name="is_absolute"/>
      <input_port name="service_name"/>
    </Action>
    <Action ID="ExecuteRemoveObject">
      <input_port name="is_exact"/>
      <input_port name="obj_name"/>
      <input_port name="service_name"/>
    </Action>
    <Action ID="ExecuteGroupJointStates">
      <input_port name="goal"/>
      <input_port name="group_name"/>
      <input_port name="service_name"/>
      <input_port name="tolerance"/>
    </Action>
    <Action ID="ExecuteGroupManyPoses">
      <input_port name="constraint"/>
      <input_port name="eef_step"/>
      <input_port name="goal_type"/>
      <input_port name="goals"/>
      <input_port name="group_name"/>
      <input_port name="service_name"/>
      <input_port name="tolerance"/>
    </Action>
    <Action ID="ExecuteGroupShift">
      <input_port name="axis"/>
      <input_port name="goal"/>
      <input_port name="group_name"/>
      <input_port name="is_absolute"/>
      <input_port name="service_name"/>
      <input_port name="tolerance"/>
    </Action>
  </TreeNodesModel>
</root>