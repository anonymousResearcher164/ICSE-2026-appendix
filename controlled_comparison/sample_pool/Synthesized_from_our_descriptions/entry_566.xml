<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Repeat num_cycles="{num_cycles}">
      <Sequence name="main_sequence">

        <!-- Pre-check -->
        <Fallback name="pre_check">
          <LTLPreCheck ltl_state_current="{ltl_state_current}"
                       ltl_state_desired_sequence="{ltl_state_desired_sequence}"/>
          <ForceFailure>
            <ReplanningRequestLevel2 replanning_request="{replanning_request}"/>
          </ForceFailure>
        </Fallback>

        <!-- Locomotion management -->
        <ReactiveSequence name="locomotion_management">

          <Fallback name="locomotion_recovery">
            <RetryUntilSuccessful num_attempts="3">
              <Fallback>
                <LocomotionStatusCheck locomotion_status="{locomotion_status}"/>
                <Sequence>
                  <RecoveryStand locomotion_status="{locomotion_status}"/>
                  <Delay delay_msec="5000">
                    <LocomotionStart locomotion_status="{locomotion_status}"/>
                  </Delay>
                </Sequence>
              </Fallback>
            </RetryUntilSuccessful>
            <ForceFailure>
              <ReplanningRequestLevel3 replanning_request="{replanning_request}"/>
            </ForceFailure>
          </Fallback>

          <Fallback name="move">
            <MoveAction move_base_finished="{move_base_finished}"
                        move_base_idle="{move_base_idle}"
                        nav_goal="{nav_goal}"/>
            <ForceFailure>
              <ReplanningRequestLevel3 replanning_request="{replanning_request}"/>
            </ForceFailure>
          </Fallback>

        </ReactiveSequence>

        <!-- LTL update -->
        <UpdateLTL action_sequence="{action_sequence}"
                   ltl_state_desired_sequence="{ltl_state_desired_sequence}"
                   nav_goal="{nav_goal}"/>

      </Sequence>
    </Repeat>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="LTLPreCheck">
      <input_port name="ltl_state_current"/>
      <input_port name="ltl_state_desired_sequence"/>
    </Action>
    <Action ID="ReplanningRequestLevel2">
      <output_port name="replanning_request"/>
    </Action>
    <Action ID="ReplanningRequestLevel3">
      <output_port name="replanning_request"/>
    </Action>
    <Action ID="LocomotionStatusCheck">
      <input_port name="locomotion_status"/>
    </Action>
    <Action ID="RecoveryStand">
      <inout_port name="locomotion_status"/>
    </Action>
    <Action ID="LocomotionStart">
      <inout_port name="locomotion_status"/>
    </Action>
    <Action ID="MoveAction">
      <input_port name="move_base_finished"/>
      <input_port name="move_base_idle"/>
      <input_port name="nav_goal"/>
    </Action>
    <Action ID="UpdateLTL">
      <inout_port name="action_sequence"/>
      <inout_port name="ltl_state_desired_sequence"/>
      <output_port name="nav_goal"/>
    </Action>
  </TreeNodesModel>
</root>