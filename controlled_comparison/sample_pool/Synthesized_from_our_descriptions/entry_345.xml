<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence>
      <GetArmJointsForPose pose="UPTRAY" joints="{joints_pose}"/>
      <SetArmJointsLeft joints="{joints_pose}"/>
      <SetArmJointsRight joints="{joints_pose}"/>

      <GetArmJointsForPose pose="EXTENDED" joints="{joints_pose}"/>
      <SetArmJointsLeft joints="{joints_pose}"/>
      <SetArmJointsRight joints="{joints_pose}"/>

      <GetArmJointsForPose pose="GRIPPING" joints="{joints_pose}"/>
      <SetArmJointsLeft joints="{joints_pose}"/>
      <SetArmJointsRight joints="{joints_pose}"/>

      <GetArmJointsForPose pose="REST" joints="{joints_pose}"/>
      <SetArmJointsLeft joints="{joints_pose}"/>
      <SetArmJointsRight joints="{joints_pose}"/>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="GetArmJointsForPose">
      <input_port name="pose"/>
      <output_port name="joints"/>
    </Action>
    <Action ID="SetArmJointsLeft">
      <input_port name="joints"/>
    </Action>
    <Action ID="SetArmJointsRight">
      <input_port name="joints"/>
    </Action>
  </TreeNodesModel>
</root>