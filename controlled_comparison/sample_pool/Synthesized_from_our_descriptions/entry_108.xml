<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <ReactiveFallback name="root_sequence">
      <ReactiveSequence name="3-goal">
        <EEYThreshold threshold="{y_threshold}" ee_y="{ee_y}"/>
        <SetMGGoal name="mg_goal3" mp_param_x="{mp_3_x}" mg_trans_x="{mg_trans_x}"/>
      </ReactiveSequence>
      <ReactiveSequence name="2-traverse">
        <EEZThreshold threshold="{z_threshold}" ee_z="{ee_z}"/>
        <SetMGGoal name="mg_goal2" mp_param_x="{mp_2_x}" mg_trans_x="{mg_trans_x}"/>
      </ReactiveSequence>
      <SetMGGoal name="mg_goal1" mp_param_x="{mp_1_x}" mg_trans_x="{mg_trans_x}"/>
    </ReactiveFallback>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="EEYThreshold">
      <input_port name="threshold"/>
      <input_port name="ee_y"/>
    </Action>
    <Action ID="EEZThreshold">
      <input_port name="threshold"/>
      <input_port name="ee_z"/>
    </Action>
    <Action ID="SetMGGoal">
      <input_port name="mp_param_x"/>
      <output_port name="mg_trans_x"/>
    </Action>
  </TreeNodesModel>
</root>