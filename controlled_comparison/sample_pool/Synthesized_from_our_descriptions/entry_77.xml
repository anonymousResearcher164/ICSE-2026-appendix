<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Repeat num_cycles="3">
      <Sequence name="speech_exchange">
        <SpeechToTextActionClient msg="{said}"/>
        <TextToSpeechActionClient msg="{said}"/>
        <SpeechToTextActionClient msg="{said}"/>
        <TextToSpeechActionClient msg="{said}"/>
      </Sequence>
    </Repeat>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="SpeechToTextActionClient">
      <input_port name="msg"/>
    </Action>
    <Action ID="TextToSpeechActionClient">
      <input_port name="msg"/>
    </Action>
  </TreeNodesModel>
</root>