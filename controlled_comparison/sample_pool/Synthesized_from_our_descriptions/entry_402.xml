<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="root_sequence">

      <!-- Initialization -->
      <Sequence name="init">
        <SetBlackboard output_key="pose_name_l" value="TouchingNeck"/>
        <SetBlackboard output_key="pose_name_r" value="TouchingNeck"/>
        <SetBlackboard output_key="pose_lr_check" value="any"/>
        <AntennaAction rate="0" intensity="0"
                       left_blink_pattern="0" right_blink_pattern="0"/>
      </Sequence>

      <!-- Detection loop -->
      <KeepRunningUntilFailure>
        <Sequence name="detection_cycle">
          <ForceSuccess>
            <Sequence name="detect_and_report">
              <HumanPoseDetect expected_pose_left="{pose_name_l}"
                               expected_pose_right="{pose_name_r}"
                               pose_lr_check="{pose_lr_check}"
                               detected_person="{detected_person}"
                               pose_left_speech="{pose_left_speech}"
                               pose_right_speech="{pose_right_speech}"/>
              <AntennaAction rate="0" intensity="10"
                             left_blink_pattern="10" right_blink_pattern="10"/>
              <SaveImageAction filename="image#.jpg"
                               directory="/home/ubuntu/saved_images"/>
              <TextToSpeechActionClient msg="Saved"/>
              <AntennaAction rate="0" intensity="0"
                             left_blink_pattern="0" right_blink_pattern="0"/>
            </Sequence>
          </ForceSuccess>
          <Delay delay_msec="1000">
            <SetBlackboard output_key="dummy" value="0"/>
          </Delay>
        </Sequence>
      </KeepRunningUntilFailure>

    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="AntennaAction">
      <input_port name="rate"/>
      <input_port name="intensity"/>
      <input_port name="left_blink_pattern"/>
      <input_port name="right_blink_pattern"/>
    </Action>
    <Action ID="HumanPoseDetect">
      <input_port name="expected_pose_left"/>
      <input_port name="expected_pose_right"/>
      <input_port name="pose_lr_check"/>
      <output_port name="detected_person"/>
      <output_port name="pose_left_speech"/>
      <output_port name="pose_right_speech"/>
    </Action>
    <Action ID="SaveImageAction">
      <input_port name="filename"/>
      <input_port name="directory"/>
    </Action>
    <Action ID="TextToSpeechActionClient">
      <input_port name="msg"/>
    </Action>
  </TreeNodesModel>
</root>