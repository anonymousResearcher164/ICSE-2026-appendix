<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Repeat num_cycles="1">
      <Sequence>
        <LookAtTray/>
        <RetryUntilSuccessful num_attempts="3">
          <Timeout msec="300">
            <DetectHandles/>
          </Timeout>
        </RetryUntilSuccessful>
        <PickTray/>
        <LookUp/>
        <MoveBack/>
        <GoToTable/>
        <PlaceTray/>
      </Sequence>
    </Repeat>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="LookAtTray"/>
    <Action ID="DetectHandles"/>
    <Action ID="PickTray"/>
    <Action ID="LookUp"/>
    <Action ID="MoveBack"/>
    <Action ID="GoToTable"/>
    <Action ID="PlaceTray"/>
  </TreeNodesModel>
</root>