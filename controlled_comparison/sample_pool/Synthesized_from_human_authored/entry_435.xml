<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Fallback name="FallbackStar">

      <SequenceWithMemory name="day_leave_shed">
        <IsOnPasture/>
        <IsDay/>
        <IsInShed/>
        <LeaveShed/>
        <FindRandomPastureField goal="{goal}"/>
        <Move goal="{goal}"/>
      </SequenceWithMemory>

      <SequenceWithMemory name="night_enter_shed">
        <IsOnPasture/>
        <IsNight/>
        <Inverter>
          <IsInShed/>
        </Inverter>
        <FindShed goal="{goal}"/>
        <Move goal="{goal}"/>
        <EnterShed/>
      </SequenceWithMemory>

      <SequenceWithMemory name="day_random_move">
        <IsDay/>
        <Inverter>
          <IsInShed/>
        </Inverter>
        <RandomMove/>
      </SequenceWithMemory>

    </Fallback>
  </BehaviorTree>

  <TreeNodesModel>
    <Condition ID="IsOnPasture"/>
    <Condition ID="IsDay"/>
    <Condition ID="IsNight"/>
    <Condition ID="IsInShed"/>
    <Action ID="LeaveShed"/>
    <Action ID="FindRandomPastureField">
      <output_port name="goal"/>
    </Action>
    <Action ID="FindShed">
      <output_port name="goal"/>
    </Action>
    <Action ID="Move">
      <input_port name="goal"/>
    </Action>
    <Action ID="EnterShed"/>
    <Action ID="RandomMove"/>
  </TreeNodesModel>
</root>