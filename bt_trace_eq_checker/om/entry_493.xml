<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Fallback>
      <initialPoseReceived/>
      <SequenceWithMemory name="doSelfLocalization">
        <RetryUntilSuccessful name="retry_client_request" num_attempts="5">
          <globalLocalizationServiceRequest/>
        </RetryUntilSuccessful>
        <RetryUntilSuccessful name="retry_localization" num_attempts="10">
          <Sequence>
            <Fallback>
              <IsLocalized/>
              <SequenceWithMemory>
                <Spin/>
                <BackUp/>
                <Spin/>
              </SequenceWithMemory>
            </Fallback>
            <IsLocalized/>
          </Sequence>
        </RetryUntilSuccessful>
      </SequenceWithMemory>
    </Fallback>
  </BehaviorTree>

  <TreeNodesModel>
    <Condition ID="initialPoseReceived"/>
    <Condition ID="IsLocalized"/>
    <Action ID="globalLocalizationServiceRequest"/>
    <Action ID="Spin"/>
    <Action ID="BackUp"/>
  </TreeNodesModel>
</root>